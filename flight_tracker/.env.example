# Local: copy to .env. Vercel: add these under Project -> Settings -> Environment Variables.
IGNAV_API_KEY=
# Optional – leave blank to skip the SerpApi Google Flights cross-check
SERPAPI_KEY=
# Optional – JEV second opinion (same key as the paper trader)
JEV_API_KEY=
JEV_MODEL=jev-latest

# Vercel only: Postgres connection string (Neon via the Vercel Marketplace sets this)
DATABASE_URL=
# Vercel only: Vercel sends "Authorization: Bearer $CRON_SECRET" to cron endpoints
CRON_SECRET=
